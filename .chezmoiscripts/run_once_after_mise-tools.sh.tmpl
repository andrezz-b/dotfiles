#!/bin/bash

# Mise tools hash: {{ include "dot_config/mise/config.toml.tmpl" | sha256sum }}

set -euo pipefail

# Set GitHub token for mise (for API rate limiting)
export GITHUB_TOKEN={{ (bitwarden "item" "Secret-GitHubAPIPAT").login.password | quote }}

# Install mise tools
mise install

# Generate mise zsh completions (the mise.run installer doesn't install them)
mkdir -p "$HOME/.local/share/zsh/completions"
mise completion zsh > "$HOME/.local/share/zsh/completions/_mise"
